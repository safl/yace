    /// Print 'obj', or null when None, to 'w', as YAML or as JSON on one line
    ///
    /// # Parameters
    ///
    /// * `flags`: one of {{ PREFIX }}_PR_DEF, {{ PREFIX }}_PR_YAML,
    ///   {{ PREFIX }}_PR_TERSE and {{ PREFIX }}_PR_JSON
    pub fn fpr(w: &mut dyn Write, obj: Option<&Self>, flags: c_int) -> io::Result<()> {
        if flags & {{ PREFIX }}_PR_JSON != 0 {
            match obj {
                Some(obj) => obj.yace_json(w)?,
                None => w.write_all(b"null")?,
            }
            return w.write_all(b"\n");
        }
        match obj {
            Some(obj) => {
                w.write_all(b"{{ record.name }}:\n")?;
                obj.yace_yaml(w, 2)
            }
            None => w.write_all(b"{{ record.name }}: ~\n"),
        }
    }

    /// Print 'obj' to stdout, as fpr()
    pub fn pr(obj: Option<&Self>, flags: c_int) -> io::Result<()> {
        Self::fpr(&mut io::stdout().lock(), obj, flags)
    }
