#[allow(dead_code)]
mod yace_pp {
    use std::ffi::{c_char, CStr};
    use std::io::{self, Write};

    pub fn strn(w: &mut dyn Write, chars: &[c_char]) -> io::Result<()> {
        w.write_all(b"\"")?;
        for &chr in chars.iter().take_while(|&&c| c != 0) {
            let chr = chr as u8;
            match chr {
                b'"' | b'\\' => w.write_all(&[b'\\', chr])?,
                0..=0x1f | 0x7f => write!(w, "\\u{:04x}", chr)?,
                _ => w.write_all(&[chr])?,
            }
        }
        w.write_all(b"\"")
    }

    pub fn str(w: &mut dyn Write, ptr: *const c_char) -> io::Result<()> {
        if ptr.is_null() {
            return w.write_all(b"null");
        }
        let bytes = unsafe { CStr::from_ptr(ptr) }.to_bytes();
        let chars: Vec<c_char> = bytes.iter().map(|&b| b as c_char).collect();
        strn(w, &chars)
    }

    pub fn ptr(w: &mut dyn Write, addr: usize) -> io::Result<()> {
        if addr == 0 {
            return w.write_all(b"null");
        }
        write!(w, "\"{:#x}\"", addr)
    }

    /// 'value' as C's printf() prints it with "%g"
    pub fn g(value: f64) -> String {
        if value.is_nan() {
            return if value.is_sign_negative() { "-nan" } else { "nan" }.into();
        }
        if value.is_infinite() {
            return if value < 0.0 { "-inf" } else { "inf" }.into();
        }
        if value == 0.0 {
            return if value.is_sign_negative() { "-0" } else { "0" }.into();
        }
        let sci = format!("{:.5e}", value);
        let (mantissa, exp) = sci.split_once('e').unwrap();
        let exp: i32 = exp.parse().unwrap();
        let trim = |text: &str| -> String {
            if text.contains('.') {
                text.trim_end_matches('0').trim_end_matches('.').into()
            } else {
                text.into()
            }
        };
        if exp < -4 || exp >= 6 {
            let sign = if exp < 0 { '-' } else { '+' };
            format!("{}e{}{:02}", trim(mantissa), sign, exp.abs())
        } else {
            trim(&format!("{:.*}", (5 - exp) as usize, value))
        }
    }
}
