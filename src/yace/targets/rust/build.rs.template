//! Links the library '{{ library }}', searching {{ PREFIX }}_LIB_DIR when set.
//! With {{ PREFIX }}_NO_LINK set, links nothing, for what uses only the types.
//!
//! Generated by yace from {{ meta.header or "the IR" }}; do not edit.

fn main() {
    println!("cargo:rerun-if-env-changed={{ PREFIX }}_LIB_DIR");
    println!("cargo:rerun-if-env-changed={{ PREFIX }}_NO_LINK");
    if let Ok(dir) = std::env::var("{{ PREFIX }}_LIB_DIR") {
        println!("cargo:rustc-link-search=native={dir}");
    }
    if std::env::var_os("{{ PREFIX }}_NO_LINK").is_none() {
        println!("cargo:rustc-link-lib={{ library }}");
    }
}
