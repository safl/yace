//! {{ meta.name }}{% if meta.brief %}: {{ meta.brief | oneline }}{% endif %}
//!
//! Zig bindings generated by yace from {{ meta.source() }}; do not
//! edit. The raw layer declares the C API as C has it, with C names; the
//! idiomatic layer, after it, is what the header says beyond C. Every struct
//! and union prints itself as the C API's pretty-printers do. Needs Zig 0.16.
{%- if meta.license %}
//!
//! SPDX-License-Identifier: {{ meta.license }}
{%- endif %}

const std = @import("std");

/// Output formats of the pretty-printers: the default, YAML
pub const {{ PREFIX }}_PR_DEF: c_int = 0x0;
/// YAML
pub const {{ PREFIX }}_PR_YAML: c_int = 0x1;
/// JSON, on one line
pub const {{ PREFIX }}_PR_JSON: c_int = 0x2;

{% filter locals("helpers") -%}
// Its names are qualified, as a declaration of the C API may share them
const yace_pp = struct {
    fn strn(w: *std.Io.Writer, chars: []const u8) std.Io.Writer.Error!void {
        try w.writeAll("\"");
        for (chars) |chr| {
            if (chr == 0) break;
            switch (chr) {
                '"', '\\' => {
                    try w.writeByte('\\');
                    try w.writeByte(chr);
                },
                0x01...0x1f, 0x7f => try w.print("\\u{x:0>4}", .{chr}),
                else => try w.writeByte(chr),
            }
        }
        try w.writeAll("\"");
    }

    fn str(w: *std.Io.Writer, chars: [*c]const u8) std.Io.Writer.Error!void {
        if (chars == null) return w.writeAll("null");
        return yace_pp.strn(w, std.mem.span(@as([*:0]const u8, @ptrCast(chars))));
    }

    fn ptr(w: *std.Io.Writer, addr: usize) std.Io.Writer.Error!void {
        if (addr == 0) return w.writeAll("null");
        return w.print("\"0x{x}\"", .{addr});
    }

    extern fn snprintf(buf: [*]u8, len: usize, fmt: [*:0]const u8, ...) c_int;

    /// 'value' as C's printf() prints it with "%g", by C's own: Zig rounds
    /// a value from its shortest decimal form, C from its binary one
    fn g(w: *std.Io.Writer, value: f64) std.Io.Writer.Error!void {
        var buf: [64]u8 = undefined;
        const len = yace_pp.snprintf(&buf, buf.len, "%g", value);
        return w.writeAll(buf[0..@intCast(len)]);
    }
};
{%- endfilter %}
{%- for entity in defines %}
{{ entity.doc | zigdoc }}
pub const {{ entity.name | ident }} = {{ entity.value | define_value }};
{%- endfor %}
{%- for entity in enums %}
{%- set name = namer(entity.name) %}
{{ entity.doc | zigdoc }}
///
/// Non-exhaustive, as C does not restrict an enum to the values it names.
pub const {{ name }} = enum({{ enum_type(entity) }}) {
{%- for member in entity.members | unique(attribute="value") %}
{%- if member.doc.brief %}
    /// {{ member.doc.brief | oneline }}
{%- endif %}
    {{ member_name(entity, member) }} = {{ member.value }},
{%- endfor %}
    _,

    /// The C name of the value, null when it is none of those named
{%- filter locals("methods") %}
    pub fn cName(self: @This()) ?[]const u8 {
        return switch (self) {
{%- for member in entity.members | unique(attribute="value") %}
            .{{ member_name(entity, member) }} => "{{ member.name }}",
{%- endfor %}
            _ => null,
        };
    }
{%- endfilter %}
};
{% for member in entity.members %}
pub const {{ member.name | ident }}: {{ enum_type(entity) }} = {{ member.value }};
{%- endfor %}
{%- endfor %}
{%- for name, zig in stubs %}

/// '{{ name }}', declared outside the headers; usable only through pointers
pub const {{ zig }} = opaque {};
{%- endfor %}
{%- for record in records %}
{%- set name = namer(record.name) %}
{{ record.doc | zigdoc }}
{%- if not record.fields %}
pub const {{ name }} = opaque {};
{%- elif record in blobs %}
///
/// Its bit-fields have no counterpart in an extern struct: only its size and
/// alignment are kept.
pub const {{ name }} = extern {{ "union" if record | is_union else "struct" }} {
    _bits: [{{ record.size }}]u8 align({{ record.align }}),
};
{%- else %}
pub const {{ name }} = extern {{ "union" if record | is_union else "struct" }} {
{%- for field in record.fields %}
{%- if field.doc.brief %}
    /// {{ field.doc.brief | oneline }}
{%- endif %}
    {{ field.name | ident }}: {{ namer.ztype(field.typ) }}{% if record.packed %} align(1){% endif %},
{%- endfor %}
{%- if record in printable %}
{% filter locals("methods") %}
    fn {{ printer.method(record, "json") }}(self: @This(), w: *std.Io.Writer) std.Io.Writer.Error!void {
{%- for line in printer.json_body(record) %}
        {{ line }}
{%- endfor %}
    }

    fn {{ printer.method(record, "yaml") }}(self: @This(), w: *std.Io.Writer, indent: usize) std.Io.Writer.Error!void {
{%- for line in printer.yaml_body(record) %}
        {{ line }}
{%- endfor %}
    }

    /// Print 'obj', or null, as YAML, or as JSON on one line, as {{ record.name }}_fpr()
    pub fn {{ printer.method(record, "fpr") }}(w: *std.Io.Writer, obj: ?*const @This(), flags: c_int) std.Io.Writer.Error!void {
        if (flags & {{ PREFIX }}_PR_JSON != 0) {
            if (obj) |o| try o.{{ printer.method(record, "json") }}(w) else try w.writeAll("null");
            return w.writeAll("\n");
        }
        if (obj) |o| {
            try w.writeAll("{{ record.name }}:\n");
            return o.{{ printer.method(record, "yaml") }}(w, 2);
        }
        return w.writeAll("{{ record.name }}: ~\n");
    }

{%- if "format" not in record.fields | map(attribute="name") %}

    /// The YAML, for "{f}"
    pub fn format(self: @This(), w: *std.Io.Writer) std.Io.Writer.Error!void {
        return @This().{{ printer.method(record, "fpr") }}(w, &self, {{ PREFIX }}_PR_YAML);
    }
{%- endif %}
{%- for line in printer.accessors(record) %}
{%- if loop.first %}
{% endif %}
{{ "    " ~ line if line }}
{%- endfor %}
{%- endfilter %}
{%- endif %}
};
{%- endif %}
{%- endfor %}
{%- for entity in typedefs %}
{{ entity.doc | zigdoc }}
pub const {{ namer(entity.name) }} = {{ namer.ztype(entity.typ) }};
{%- endfor %}
{%- for function in functions %}
{{ function.doc | zigdoc }}
pub extern fn {{ function.name | ident }}({% for param in function.params %}{{ params(function)[loop.index0] }}: {{ namer.ztype(param.typ, True) }}{% if not loop.last or function.variadic %}, {% endif %}{% endfor %}{% if function.variadic %}...{% endif %}) {{ namer.ztype(function.ret) }};
{%- endfor %}

{{ idiomatic }}
