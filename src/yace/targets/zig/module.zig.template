//! {{ meta.name }}{% if meta.brief %}: {{ meta.brief | oneline }}{% endif %}
//!
//! Zig bindings generated by yace from {{ meta.source() }}; do not
//! edit. The raw layer declares the C API with its C names; the idiomatic
//! layer follows it. Every struct and union with fields has pretty-printers.
//! The module needs Zig 0.16.
{%- if meta.license %}
//!
