//! {{ meta.name }}: check of the generated Zig bindings
//!
//! Asserts, at compile time, that the records have the layout recorded in the
//! IR, then prints a zeroed instance of every record, as YAML documents with
//! argument "yaml" or JSON lines with argument "json", for the caller to
//! parse. Calls no function of the library.
//!
//! Generated by yace from {{ meta.header or "the IR" }}; do not edit.

const std = @import("std");
const api = @import("{{ prefix }}.zig");

comptime {
{%- if layout %}
{%- for record in printable if record.size %}
{%- set name = namer(record.name) %}
    std.debug.assert(@sizeOf(api.{{ name }}) == {{ record.size }});
    std.debug.assert(@alignOf(api.{{ name }}) == {{ record.align }});
{%- for field in record.fields if field.offset is not none and not record | is_union %}
    std.debug.assert(@offsetOf(api.{{ name }}, "{{ field.name }}") == {{ field.offset // 8 }});
{%- endfor %}
{%- endfor %}
{%- endif %}
}

pub fn main(init: std.process.Init) !void {
    var buf: [4096]u8 = undefined;
    var stdout = std.Io.File.stdout().writer(init.io, &buf);
    const w = &stdout.interface;

    var args = init.minimal.args.iterate();
    _ = args.next();
    const as_json = if (args.next()) |arg| std.mem.eql(u8, arg, "json") else false;
    const flags = if (as_json) api.{{ PREFIX }}_PR_JSON else api.{{ PREFIX }}_PR_YAML;
{%- if not printable %}
    _ = flags;
{%- endif %}
{%- for record in printable %}

    {
        const obj = std.mem.zeroes(api.{{ namer(record.name) }});
        if (!as_json) try w.writeAll("---\n");
        try api.{{ namer(record.name) }}.{{ printer.method(record, "fpr") }}(w, &obj, flags);
    }
{%- endfor %}
    try w.flush();
}
