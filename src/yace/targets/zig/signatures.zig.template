//! {{ meta.name }}: check of the Zig bindings' signatures against the headers
//!
//! Imports the headers the IR was parsed from, by Zig's own translation of C,
//! and asserts, at compile time, that each extern function of the bindings
//! takes and returns what the header's does, as the C ABI sees it: as many
//! parameters, and each, and the return, of the same class, pointer, float or
//! other, size and alignment, field by field for a record passed by value. Zig, not yace, translates the header.
//!
//! Generated by yace from {{ meta.source() }}; do not edit.

const std = @import("std");
const api = @import("{{ prefix }}.zig");
const c = @cImport({
{%- for name in standard + meta.prelude + meta.headers %}
    @cInclude("{{ name }}");
{%- endfor %}
});

/// What the C ABI sees of a parameter or a return: its class, pointer, float
/// or other, with its size and alignment, and for a record by value those of
/// each field; an optional pointer is a pointer
fn shape(comptime T: type) []const usize {
    return switch (@typeInfo(T)) {
        .optional => |o| shape(o.child),
        .pointer => &.{ 1, @sizeOf(usize), @alignOf(usize) },
        .void, .noreturn => &.{ 0, 0, 0 },
        .float => &.{ 2, @sizeOf(T), @alignOf(T) },
        .@"struct", .@"union" => blk: {
            var parts: []const usize = &.{ 3, @sizeOf(T), @alignOf(T) };
            for (std.meta.fields(T)) |f| parts = parts ++ shape(f.type);
            break :blk parts;
        },
        else => &.{ 0, @sizeOf(T), @alignOf(T) },
    };
}

fn agree(comptime name: []const u8) void {
    const fail = name ++ ": the bindings and the headers disagree on ";
    if (!@hasDecl(c, name))
        @compileError(fail ++ "whether it is declared");
    const ours = @typeInfo(@TypeOf(@field(api, name))).@"fn";
    const theirs = @typeInfo(@TypeOf(@field(c, name))).@"fn";
    if (ours.params.len != theirs.params.len or ours.is_var_args != theirs.is_var_args)
        @compileError(fail ++ "its parameters");
    if (!std.mem.eql(usize, shape(ours.return_type.?), shape(theirs.return_type.?)))
        @compileError(fail ++ "its return");
    for (ours.params, theirs.params, 0..) |a, b, i| {
        if (!std.mem.eql(usize, shape(a.type.?), shape(b.type.?)))
            @compileError(fail ++ std.fmt.comptimePrint("parameter {d}", .{i}));
    }
}

comptime {
    @setEvalBranchQuota(1000 + 1000 * {{ functions | length }});
{%- for function in functions %}
    agree("{{ function.name }}");
{%- endfor %}
}
