//! {{ meta.name }}: all of the generated Zig bindings, compiled
//!
//! Zig compiles only what is referenced: this references every declaration of
//! the module, for it to be compiled, but not linked, as the library is not.
//! Generic functions, those taking a callback, are compiled where called.
//!
//! Generated by yace from {{ meta.header or "the IR" }}; do not edit.

const std = @import("std");
const api = @import("{{ prefix }}.zig");

/// Reference every declaration of T, and of the types it declares
fn refAll(comptime T: type) void {
    const decls = switch (@typeInfo(T)) {
        inline .@"struct", .@"enum", .@"union" => |info| info.decls,
        else => return,
    };
    // Each declaration takes a few branches; the default allows 1000 in all
    @setEvalBranchQuota(1000 + 100 * decls.len);
    inline for (decls) |decl| {
        const field = @field(T, decl.name);
        switch (@typeInfo(@TypeOf(field))) {
            .@"fn" => |func| if (!func.is_generic) {
                _ = &field;
            },
            .type => switch (@typeInfo(field)) {
                .@"struct", .@"enum", .@"union" => refAll(field),
                else => {},
            },
            else => _ = &field,
        }
    }
}

comptime {
    refAll(api);
}
