//! Compiles all of the generated Zig bindings of {{ meta.name }}
//!
//! Zig compiles only what is referenced, so this file references every
//! declaration of the module, except the generic functions. It links nothing.
//!
//! Generated by yace from {{ meta.source() }}; do not edit.

const std = @import("std");
const api = @import("{{ prefix }}.zig");

fn refAll(comptime T: type) void {
    const decls = switch (@typeInfo(T)) {
        inline .@"struct", .@"enum", .@"union" => |info| info.decls,
        else => return,
    };
    // Each declaration takes a few branches of the default quota of 1000
    @setEvalBranchQuota(1000 + 100 * decls.len);
    inline for (decls) |decl| {
        const field = @field(T, decl.name);
        switch (@typeInfo(@TypeOf(field))) {
            .@"fn" => |func| if (!func.is_generic) {
                _ = &field;
            },
            .type => switch (@typeInfo(field)) {
                .@"struct", .@"enum", .@"union" => refAll(field),
                else => {},
            },
            else => _ = &field,
        }
    }
}

comptime {
    refAll(api);
}
