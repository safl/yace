            return value[0]
        return value.split(b"\0", 1)[0].decode(errors="replace")
    if isinstance(value, memoryview):
        value = value.tolist()
    if isinstance(value, (list, tuple)):
        return [_plain(item, kind) for item in value]
    if kind == "pointer":
        return None if not value else f"0x{value:x}"
    if isinstance(value, float):
        return float(format(value, "g"))
    return value


class _Bits(dict):
    """The value of a field of bits and its parts by name. _yaml() prints a
    _Bits on one line."""


def _yaml(data, indent):
    lines = []
    for key, value in data.items():
        if isinstance(value, _Bits):
            parts = ", ".join(f"{name}: {part:#x}" for name, part in value.items())
            lines.append(f"{'':{indent}}{key}: " + "{" + parts + "}\n")
        elif isinstance(value, dict):
            lines.append(f"{'':{indent}}{key}:\n{_yaml(value, indent + 2)}")
        else:
            lines.append(f"{'':{indent}}{key}: {_json.dumps(value)}\n")
    return "".join(lines)


