{%- if "strn" in helpers %}

/* At most 'len' characters of 'str', quoted and escaped */
YACE_PP_HELPER int
yace_pp_strn(struct yace_pp *pp, const char *key, const char *str, size_t len)
{
	int wrtn = yace_pp_key(pp, key);

	if (!str) {
		wrtn += fprintf(pp->stream, "null");
		return wrtn + yace_pp_eol(pp);
	}

	wrtn += fprintf(pp->stream, "\"");
	for (size_t i = 0; i < len && str[i]; ++i) {
		unsigned char chr = (unsigned char)str[i];

		if (chr == '"' || chr == '\\') {
			wrtn += fprintf(pp->stream, "\\%c", chr);
		} else if (chr < 0x20 || chr == 0x7f) {
			wrtn += fprintf(pp->stream, "\\u%04x", chr);
		} else {
			wrtn += fprintf(pp->stream, "%c", chr);
		}
	}
	wrtn += fprintf(pp->stream, "\"");

	return wrtn + yace_pp_eol(pp);
}
{%- endif %}

{%- if "str" in helpers %}

YACE_PP_HELPER int
yace_pp_str(struct yace_pp *pp, const char *key, const char *str)
{
	return yace_pp_strn(pp, key, str, SIZE_MAX);
}
{%- endif %}

{%- if "nest" in helpers %}

/* The key of a record, whose fields follow in YAML on the lines below */
YACE_PP_HELPER int
yace_pp_nest(struct yace_pp *pp, const char *key)
{
	if (key && !pp->json) {
		return fprintf(pp->stream, "%*s%s:\n", pp->indent, "", key);
	}

	return yace_pp_key(pp, key);
}
