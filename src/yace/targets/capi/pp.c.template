{%- if complete %}

/* The printers are not on a fast path, so the helpers stay out of line;
 * inlined at every field, they make the printers much larger */
#if defined(__GNUC__)
#define YACE_PP_HELPER __attribute__((noinline)) static
#else
#define YACE_PP_HELPER static
#endif

/* Where and how a record is printed: as JSON on one line, or as YAML with its
 * fields at 'indent'; of JSON, 'count' is the values printed in the object or
 * list, which a separator follows */
struct yace_pp {
	FILE *stream;
	int json;
	int indent;
	int count;
};
{%- endif %}

{%- if "key" in helpers %}

/* A key, or of an element of a list, a NULL key, only the separator; a list is
 * printed as JSON, also in YAML, so a NULL key is never printed as YAML */
YACE_PP_HELPER int
yace_pp_key(struct yace_pp *pp, const char *key)
{
	if (!key) {
		return fprintf(pp->stream, "%s", pp->count++ ? ", " : "");
	}
	if (!pp->json) {
		return fprintf(pp->stream, "%*s%s: ", pp->indent, "", key);
	}

	return fprintf(pp->stream, "%s\"%s\": ", pp->count++ ? ", " : "", key);
}
{%- endif %}

{%- if "eol" in helpers %}

YACE_PP_HELPER int
yace_pp_eol(struct yace_pp *pp)
{
	return pp->json ? 0 : fprintf(pp->stream, "\n");
}
{%- endif %}

{%- if "null" in helpers %}

YACE_PP_HELPER int
yace_pp_null(struct yace_pp *pp, const char *key)
{
	int wrtn = yace_pp_key(pp, key);

	wrtn += fprintf(pp->stream, "null");

	return wrtn + yace_pp_eol(pp);
}
{%- endif %}

