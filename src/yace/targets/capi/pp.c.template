/* A field of bits: a mapping on one line of its value and of each of its parts */
YACE_PP_HELPER int
yace_pp_bits(struct yace_pp *pp, const char *key, uintmax_t val)
{
	int wrtn = yace_pp_key(pp, key);

	if (pp->json) {
		return wrtn + fprintf(pp->stream, "{\"{{ value_key }}\": %ju", val);
