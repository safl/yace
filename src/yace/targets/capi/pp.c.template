{%- if "ptr" in helpers %}

YACE_PP_HELPER int
yace_pp_ptr(struct yace_pp *pp, const char *key, uintptr_t val)
{
	int wrtn = yace_pp_key(pp, key);

	if (val) {
		wrtn += fprintf(pp->stream, "\"0x%" PRIxPTR "\"", val);
	} else {
		wrtn += fprintf(pp->stream, "null");
	}

	return wrtn + yace_pp_eol(pp);
}
