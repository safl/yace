{%- if "list" in helpers %}

/* The key of an array, and the context of its elements: a list, on one line */
YACE_PP_HELPER int
yace_pp_list(struct yace_pp *pp, struct yace_pp *list, const char *key)
{
	int wrtn = yace_pp_key(pp, key);

	*list = (struct yace_pp){pp->stream, 1, 0, 0};

	return wrtn + fprintf(pp->stream, "[");
}
{%- endif %}

