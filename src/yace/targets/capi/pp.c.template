{%- if complete %}

/* The start of a record: in JSON a brace, in YAML its fields one level in */
YACE_PP_HELPER int
yace_pp_open(struct yace_pp *pp)
{
	if (!pp->json) {
		pp->indent += 2;
		return 0;
	}
	pp->count = 0;

	return fprintf(pp->stream, "{");
}

YACE_PP_HELPER int
yace_pp_close(struct yace_pp *pp)
{
	return pp->json ? fprintf(pp->stream, "}") : 0;
}

/* The start of a record printed by its printer: its name, in YAML */
YACE_PP_HELPER int
yace_pp_head(struct yace_pp *pp, const char *name, const void *obj)
{
	if (pp->json) {
		return obj ? 0 : fprintf(pp->stream, "null");
	}

	return fprintf(pp->stream, "%s:%s\n", name, obj ? "" : " ~");
}

YACE_PP_HELPER int
yace_pp_tail(struct yace_pp *pp)
{
	return pp->json ? fprintf(pp->stream, "\n") : 0;
}
