{%- if "strn" in helpers %}

static int
yace_pp_strn(FILE *stream, const char *str, size_t len)
{
	int wrtn = 0;

	if (!str) {
		return fprintf(stream, "null");
	}

	wrtn += fprintf(stream, "\"");
	for (size_t i = 0; i < len && str[i]; ++i) {
		unsigned char chr = (unsigned char)str[i];

		if (chr == '"' || chr == '\\') {
			wrtn += fprintf(stream, "\\%c", chr);
		} else if (chr < 0x20 || chr == 0x7f) {
			wrtn += fprintf(stream, "\\u%04x", chr);
		} else {
			wrtn += fprintf(stream, "%c", chr);
		}
	}
	wrtn += fprintf(stream, "\"");

	return wrtn;
}
{%- endif %}

{%- if "str" in helpers %}

