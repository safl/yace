{% if entity.doc %}
/**
 * {{ entity.doc.brief }}
 *
{%- if entity.doc.description %}
 * {{ entity.doc.description.replace("\n", "\n * ") }}
 *
{%- endif %}
 * @enum {{ entity.sym }}
 */
{%- endif %}
enum {{ entity.sym }} {
{%- for member in entity.members %}
	{{ member.sym }} = {% if member.val.lit < 0 %}{{ member.val.lit }}{% else %}{{ '0x%0x' % member.val.lit }}{% endif %},{% if member.doc %} ///< {{ member.doc.brief | sanitize_comment }}{% endif %}
{%- endfor %}
};
