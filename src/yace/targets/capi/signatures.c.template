/**
 * {{ meta.name }}: check of the signatures of the IR against the headers
 *
 * Includes the headers the IR was parsed from, after what yace parsed them
 * after, not the generated C API, and
 * asserts, at compile time, that each function they declare has the type the
 * IR gives it, from which every target declares it. The compiler, not yace,
 * says whether the two agree.
 *
 * @file {{ meta.prefix }}_signatures.c
 *
 * Generated by yace from {{ meta.source() }}; do not edit.
 */
{%- for name in standard + meta.prelude %}
#include <{{ name }}>
{%- endfor %}
{%- for name in meta.headers %}
#include "{{ name }}"
{%- endfor %}
{%- for function in functions %}

_Static_assert(__builtin_types_compatible_p(__typeof__(&{{ function.name }}), {{ function | pointer_type(spelled) }}),
	       "{{ function.name }}: the IR and the headers disagree on its type");
{%- endfor %}
