/**
 * Output formats of the pretty-printers
 */
enum {{ prefix }}_pr {
	{{ PREFIX }}_PR_DEF   = 0x0, ///< The default, YAML
	{{ PREFIX }}_PR_YAML  = 0x1, ///< YAML
	{{ PREFIX }}_PR_TERSE = 0x2, ///< Terse; the generated printers print YAML
	{{ PREFIX }}_PR_JSON  = 0x4, ///< JSON, on one line
};
{%- for record in complete %}

/**
 * Print the given {{ record | tag }} {{ record.name }} to the given stream
 *
 * @param stream The stream to print to
 * @param obj The {{ record | tag }} to print, NULL prints as null
 * @param flags The output format, one of enum {{ prefix }}_pr
 *
 * @return The number of characters written
 */
int
{{ record.name }}_fpr(FILE *stream, const {{ record | tag }} {{ record.name }} *obj, int flags);

/**
 * Print the given {{ record | tag }} {{ record.name }} to stdout
 *
 * @param obj The {{ record | tag }} to print, NULL prints as null
 * @param flags The output format, one of enum {{ prefix }}_pr
 *
 * @return The number of characters written
 */
int
{{ record.name }}_pr(const {{ record | tag }} {{ record.name }} *obj, int flags);
{%- endfor %}
{%- for entity in enums %}

/**
 * The name of the given enum {{ entity.name }} value, "UNKNOWN" when it is none of them
 */
const char *
{{ entity.name }}_str(int value);
{%- endfor %}
