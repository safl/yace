{% if entity.doc %}
/**
 * {{ entity.doc.brief | sanitize_comment }}
 *
{%- if entity.doc.description %}
 * {{ entity.doc.description.replace("\n", "\n * ") | sanitize_comment }}
 *
{%- endif %}
{%- for tag, params in entity.doc.tags.items() if tag == "param" %}
{%- for param, brief in params.items() %}
 * @{{ tag }} {{ param }} {{ brief | sanitize_comment }}
{%- endfor %}
{%- endfor %}
 *
{%- if "return" in entity.doc.tags %}
 * @return {{ entity.doc.tags.return }}
{%- endif %}
 */
{%- endif %}
typedef {{ entity.ret.c_spelling() }} (*{{ entity.sym }})
({% for parameter in entity.parameters %}{{ parameter.typ.c_decl(parameter.sym) }}{{ ", " if not loop.last else "" }}{% endfor %});
