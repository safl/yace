_LIBRARY = None


def _api():
    """The shared library, loaded, with the signatures of its functions set"""

    global _LIBRARY

    if _LIBRARY is None:
        path = _os.environ.get("{{ PREFIX }}_LIBRARY") or ctypes.util.find_library(
            "{{ library }}"
        )
        if not path:
            raise OSError(
                "no library '{{ library }}' found; set {{ PREFIX }}_LIBRARY to its path"
            )
        lib = ctypes.CDLL(path)
        for name, (restype, argtypes) in _SIGNATURES.items():
            func = _builtins.getattr(lib, name, None)
            if func is not None:
                func.restype = restype
                func.argtypes = argtypes
        _LIBRARY = lib

    return _LIBRARY


def _str_in(value):
    """A str argument, encoded, for a 'const char *' parameter"""

    return value.encode() if _builtins.isinstance(value, _builtins.str) else value


def _str_out(value):
    return None if value is None else value.decode(errors="replace")


def _ptr_out(value):
    """A NULL pointer returned, as None"""

    return value if value else None


def _plain(ctype, value):
    """'value', of the C type 'ctype', as what the pretty-printers print"""

    if ctype is ctypes.c_char:
        return value[0]
    if ctype is ctypes.c_char_p:
        return _str_out(value)
    if ctype is ctypes.c_void_p:
        return None if not value else f"0x{value:x}"
    if ctype in (ctypes.c_float, ctypes.c_double):
        return _builtins.float(_builtins.format(value, "g"))
    if _builtins.issubclass(ctype, ctypes.Array):
        if not ctype._length_:
            return None
        if ctype._type_ is ctypes.c_char:
            raw = value if _builtins.isinstance(value, _builtins.bytes) else _builtins.bytes(value)
            return _str_out(raw.split(b"\0", 1)[0])
        return [_plain(ctype._type_, item) for item in value]
    if _builtins.issubclass(ctype, _Record):
        return _Record.to_dict(value)
    if _builtins.issubclass(ctype, (ctypes._Pointer, ctypes._CFuncPtr)):
        addr = ctypes.cast(value, ctypes.c_void_p).value
        return None if not addr else f"0x{addr:x}"
    if _builtins.issubclass(ctype, (ctypes.Structure, ctypes.Union)):
        return None
    return value


class _Bits(_builtins.dict):
    """A field of bits, its value and its parts by name, printed on one line"""


def _yaml(data, indent):
    lines = []
    for key, value in data.items():
        if _builtins.isinstance(value, _Bits):
            parts = ", ".join(f"{name}: {part:#x}" for name, part in value.items())
            lines.append(f"{'':{indent}}{key}: " + "{" + parts + "}\n")
        elif _builtins.isinstance(value, _builtins.dict):
            lines.append(f"{'':{indent}}{key}:\n{_yaml(value, indent + 2)}")
        else:
            lines.append(f"{'':{indent}}{key}: {_json.dumps(value)}\n")
    return "".join(lines)


class {{ Prefix }}Pr(enum.IntFlag):
    """Output formats of the pretty-printers"""

    {{ PREFIX }}_PR_DEF = 0x0  #: The default, YAML
    {{ PREFIX }}_PR_YAML = 0x1  #: YAML
    {{ PREFIX }}_PR_JSON = 0x2  #: JSON, on one line


{{ PREFIX }}_PR_DEF = {{ Prefix }}Pr.{{ PREFIX }}_PR_DEF
{{ PREFIX }}_PR_YAML = {{ Prefix }}Pr.{{ PREFIX }}_PR_YAML
{{ PREFIX }}_PR_JSON = {{ Prefix }}Pr.{{ PREFIX }}_PR_JSON


class _Record(object):
    """The pretty-printers of a struct or union; called through _Record, as a
    field of the same name hides one"""

    _yace_name = ""
    _yace_masks = {}  # the parts of each field of bits: name, mask and shift
    _yace_enums = {}  # the enum of each field typed as one

    def to_dict(self):
        """The fields, by name, as plain values: pointers as hex strings, a
        field of bits as its value and its parts"""

        cls = _builtins.type(self)
        found = {}
        for name, ctype, *_ in cls._fields_:
            if not name:
                continue  # a padding bit-field
            value = _plain(ctype, _builtins.getattr(self, name))
            if name in cls._yace_masks:
                value = _Bits(
                    {"{{ value_key }}": value},
                    **{part: (value & mask) >> lo for part, mask, lo in cls._yace_masks[name]},
                )
            found[name] = value
        return found

    @classmethod
    def fpr(cls, stream, obj, flags={{ PREFIX }}_PR_DEF):
        """Print 'obj', a record, a pointer to one, or None, to 'stream'

        Returns:
            The number of characters written
        """

        if _builtins.isinstance(obj, ctypes._Pointer):
            obj = obj.contents if obj else None
        if flags & {{ PREFIX }}_PR_JSON:
            text = _json.dumps(None if obj is None else _Record.to_dict(obj)) + "\n"
        elif obj is None:
            text = f"{cls._yace_name}: ~\n"
        else:
            text = f"{cls._yace_name}:\n{_yaml(_Record.to_dict(obj), 2)}"
        stream.write(text)
        return _builtins.len(text)

    @classmethod
    def pr(cls, obj, flags={{ PREFIX }}_PR_DEF):
        """Print 'obj' to stdout, as fpr()"""

        return _Record.fpr.__func__(cls, _sys.stdout, obj, flags)

    def __str__(self):
        return f"{self._yace_name}:\n{_yaml(_Record.to_dict(self), 2)}"

    def __repr__(self):
        """As the constructor is called: each field by name, every one of a
        union, as which member is meant is not known"""

        cls = _builtins.type(self)
        fields = []
        for name, *_ in cls._fields_:
            value = _builtins.getattr(self, name)
            fields.append(f"{name}={_repr(value, cls._yace_enums.get(name))}")
        return f"{cls.__name__}({', '.join(fields)})"


def _repr(value, enum=None):
    """A field's value, as __repr__() shows it: an array as a list, and a value
    of 'enum' by the name of its member, if it is one"""

    if _builtins.isinstance(value, ctypes.Array) and value._type_ is ctypes.c_char:
        return _builtins.repr(value.value)
    if _builtins.isinstance(value, ctypes.Array):
        return "[" + ", ".join(_repr(item, enum) for item in value) + "]"
    if enum is not None:
        try:
            return f"{enum.__name__}.{enum(value).name}"
        except _builtins.ValueError:
            pass
    return _builtins.repr(value)
