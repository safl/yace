def _compact(shape, strides, itemsize):
    """The size in bytes of an array of 'shape' laid out by 'strides', in
    elements, or by rows where 'strides' is None; ValueError where the array is
    not one contiguous range of memory in row order"""

    nbytes = itemsize
    for extent in shape:
        nbytes *= extent
    if strides is not None and nbytes:
        expected = 1
        for extent, stride in _builtins.zip(_builtins.reversed(shape), _builtins.reversed(strides)):
            if extent != 1 and stride != expected:
                raise ValueError("the array is not contiguous")
            expected *= extent
    return nbytes


def _dlpack(obj):
    """The address, size in bytes and read-only flag of the memory of a DLPack
    tensor, and the capsule that holds the memory. The capsule is not consumed,
    so dropping it is what releases the tensor."""

    try:
        capsule = obj.__dlpack__(max_version=(1, 0))
    except TypeError:
        capsule = obj.__dlpack__()
    try:
        address = _CAPSULE_POINTER(capsule, b"dltensor_versioned")
        managed = _DLManagedTensorVersioned.from_address(address)
        readonly = _builtins.bool(managed.flags & 1)
    except ValueError:
        address = _CAPSULE_POINTER(capsule, b"dltensor")
        managed = _DLManagedTensor.from_address(address)
        readonly = False
    tensor = managed.dl_tensor
    shape = [tensor.shape[i] for i in _builtins.range(tensor.ndim)]
    strides = None
    if tensor.strides:
        strides = [tensor.strides[i] for i in _builtins.range(tensor.ndim)]
    itemsize = (tensor.dtype.bits * tensor.dtype.lanes + 7) // 8
    nbytes = _compact(shape, strides, itemsize)
    return (tensor.data or 0) + tensor.byte_offset, nbytes, readonly, capsule


def _cuda_array(obj):
    """The address, size in bytes and read-only flag of the memory of a CUDA
    array, and the array, which holds the memory"""

    interface = obj.__cuda_array_interface__
    address, readonly = interface["data"]
    itemsize = _builtins.int(interface["typestr"][2:])
    strides = interface.get("strides")
    if strides is not None:
        if _builtins.any(stride % itemsize for stride in strides):
            raise ValueError("the array is not contiguous")
        strides = [stride // itemsize for stride in strides]
    nbytes = _compact(interface["shape"], strides, itemsize)
    return address, nbytes, readonly, obj


class _Device(object):
    """A buffer over the memory of a DLPack tensor or a CUDA array. The memory
    may be a device's: pass its address to C, do not read it."""

    def __init__(self, address, nbytes, readonly, keep):
        self._array = (ctypes.c_ubyte * nbytes).from_address(address)
        self._readonly = readonly
        self._keep = keep

    def __buffer__(self, flags):
        view = _builtins.memoryview(self._array).cast("B")
        if self._readonly and flags & 1:
            raise BufferError("the memory is read-only")
        return view.toreadonly() if self._readonly else view


class _Memory(object):
    """The address and size in bytes of the memory of an object, held until
    release(): its buffer, its DLPack tensor or its CUDA array, without a copy.
    Any other object is copied into bytes, where C does not write it."""

    def __init__(self, obj, writable):
        self._view = None
        exporter = obj
        if not _CHECK_BUFFER(obj):
            if _builtins.hasattr(obj, "__dlpack__"):
                exporter = _Device(*_dlpack(obj))
            elif _builtins.hasattr(obj, "__cuda_array_interface__"):
                exporter = _Device(*_cuda_array(obj))
            elif writable:
                raise TypeError(f"expected a writable buffer, not {_builtins.type(obj).__name__}")
            else:
                exporter = _builtins.bytes(obj)
        view = _PyBuffer()
        _GET_BUFFER(exporter, ctypes.byref(view), 1 if writable else 0)
        self._view = view
        self.address = view.buf
        self.nbytes = view.len

    def release(self):
        if self._view is not None:
            _RELEASE_BUFFER(ctypes.byref(self._view))
            self._view = None

    def __del__(self):
        self.release()


def _fits(value, ctype):
    """Return 'value', or raise OverflowError where the C integer type 'ctype'
    cannot hold it, as ctypes truncates an argument"""

    if ctype(value).value != value:
        raise OverflowError(f"{value} does not fit in {ctype.__name__}")
    return value


def _str_out(value):
    return None if value is None else value.decode(errors="replace")


def _str_check(value, func, args):
    """A string returned, decoded"""

    return _str_out(value)


def _ptr_check(value, func, args):
    """A NULL pointer returned, as None"""

    return value if value else None


def _plain(ctype, value):
    """'value', of the C type 'ctype', as what the pretty-printers print"""

    if ctype is ctypes.c_char:
        return value[0]
    if ctype is ctypes.c_char_p:
        return _str_out(value)
    if ctype is ctypes.c_void_p:
        return None if not value else f"0x{value:x}"
    if ctype in (ctypes.c_float, ctypes.c_double):
        return _builtins.float(_builtins.format(value, "g"))
    if _builtins.issubclass(ctype, ctypes.Array):
        if not ctype._length_:
            return None
        if ctype._type_ is ctypes.c_char:
            raw = value if _builtins.isinstance(value, _builtins.bytes) else _builtins.bytes(value)
            return _str_out(raw.split(b"\0", 1)[0])
        return [_plain(ctype._type_, item) for item in value]
    if _builtins.issubclass(ctype, _Record):
        return _Record.to_dict(value)
    if _builtins.issubclass(ctype, (ctypes._Pointer, ctypes._CFuncPtr)):
        addr = ctypes.cast(value, ctypes.c_void_p).value
        return None if not addr else f"0x{addr:x}"
    if _builtins.issubclass(ctype, (ctypes.Structure, ctypes.Union)):
        return None
    return value


class _Bits(_builtins.dict):
    """A field of bits, its value and its parts by name, printed on one line"""


def _yaml(data, indent):
    lines = []
    for key, value in data.items():
        if _builtins.isinstance(value, _Bits):
            parts = ", ".join(f"{name}: {part:#x}" for name, part in value.items())
            lines.append(f"{'':{indent}}{key}: " + "{" + parts + "}\n")
        elif _builtins.isinstance(value, _builtins.dict):
            lines.append(f"{'':{indent}}{key}:\n{_yaml(value, indent + 2)}")
        else:
            lines.append(f"{'':{indent}}{key}: {_json.dumps(value)}\n")
    return "".join(lines)


class {{ Prefix }}Pr(enum.IntFlag):
    """Output formats of the pretty-printers"""

    {{ PREFIX }}_PR_DEF = 0x0  #: The default, YAML
    {{ PREFIX }}_PR_YAML = 0x1  #: YAML
    {{ PREFIX }}_PR_TERSE = 0x2  #: Terse; the generated printers print YAML
    {{ PREFIX }}_PR_JSON = 0x4  #: JSON, on one line


{{ PREFIX }}_PR_DEF = {{ Prefix }}Pr.{{ PREFIX }}_PR_DEF
{{ PREFIX }}_PR_YAML = {{ Prefix }}Pr.{{ PREFIX }}_PR_YAML
{{ PREFIX }}_PR_TERSE = {{ Prefix }}Pr.{{ PREFIX }}_PR_TERSE
{{ PREFIX }}_PR_JSON = {{ Prefix }}Pr.{{ PREFIX }}_PR_JSON


class _Record(object):
    """The pretty-printers of a struct or union. They are called through
    _Record, as a field of the same name hides one."""

    _yace_name = ""
    _yace_masks = {}  # the parts of each field of bits: name, mask and shift
    _yace_enums = {}  # the enum of each field typed as one

    def to_dict(self):
        """The fields, by name, as plain values: pointers as hex strings, a
        field of bits as its value and its parts"""

        cls = _builtins.type(self)
        found = {}
        for name, ctype, *_ in cls._fields_:
            if not name:
                continue  # a padding bit-field
            value = _plain(ctype, _builtins.getattr(self, name))
            if name in cls._yace_masks:
                value = _Bits(
                    {"{{ value_key }}": value},
                    **{part: (value & mask) >> lo for part, mask, lo in cls._yace_masks[name]},
                )
            found[name] = value
        return found

    @classmethod
    def fpr(cls, stream, obj, flags={{ PREFIX }}_PR_DEF):
        """Print 'obj', a record, a pointer to one, or None, to 'stream'

        Returns:
            The number of characters written
        """

        if _builtins.isinstance(obj, ctypes._Pointer):
            obj = obj.contents if obj else None
        if flags & {{ PREFIX }}_PR_JSON:
            text = _json.dumps(None if obj is None else _Record.to_dict(obj)) + "\n"
        elif obj is None:
            text = f"{cls._yace_name}: ~\n"
        else:
            text = f"{cls._yace_name}:\n{_yaml(_Record.to_dict(obj), 2)}"
        stream.write(text)
        return _builtins.len(text)

    @classmethod
    def pr(cls, obj, flags={{ PREFIX }}_PR_DEF):
        """Print 'obj' to stdout, as fpr()"""

        return _Record.fpr.__func__(cls, _sys.stdout, obj, flags)

    def __str__(self):
        return f"{self._yace_name}:\n{_yaml(_Record.to_dict(self), 2)}"

    def __repr__(self):
        """A call of the constructor with each field by name. A union shows
        every member, as the one in use is not known."""

        cls = _builtins.type(self)
        fields = []
        for name, *_ in cls._fields_:
            value = _builtins.getattr(self, name)
            fields.append(f"{name}={_repr(value, cls._yace_enums.get(name))}")
        return f"{cls.__name__}({', '.join(fields)})"


def _repr(value, enum=None):
    """A field's value, as __repr__() shows it: an array as a list, a pointer
    as its address or None, and a value of 'enum' by the name of its member,
    if it is one"""

    if _builtins.isinstance(value, (ctypes._Pointer, ctypes._CFuncPtr)):
        return _builtins.repr(ctypes.cast(value, ctypes.c_void_p).value)
    if _builtins.isinstance(value, ctypes.Array) and value._type_ is ctypes.c_char:
        return _builtins.repr(value.value)
    if _builtins.isinstance(value, ctypes.Array):
        return "[" + ", ".join(_repr(item, enum) for item in value) + "]"
    if enum is not None:
        try:
            return f"{enum.__name__}.{enum(value).name}"
        except _builtins.ValueError:
            pass
    return _builtins.repr(value)
