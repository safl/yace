_LIBRARY = None


def _api():
    """The shared library, loaded, with the signatures of its functions set"""

    global _LIBRARY

    if _LIBRARY is None:
        path = _os.environ.get("{{ PREFIX }}_LIBRARY") or ctypes.util.find_library(
            "{{ library }}"
        )
        if not path:
            raise OSError(
                "no library '{{ library }}' found; set {{ PREFIX }}_LIBRARY to its path"
            )
        lib = ctypes.CDLL(path)
        for name, (restype, argtypes, errcheck) in _SIGNATURES.items():
            func = _builtins.getattr(lib, name, None)
            if func is not None:
                func.restype = restype
                func.argtypes = argtypes
                if errcheck is not None:
                    func.errcheck = errcheck
        _LIBRARY = lib
        scope = _builtins.globals()
        for name, pyname in _DIRECT:
            func = _builtins.getattr(lib, name, None)
            if func is not None:
                func.__doc__ = scope[pyname].__doc__
                func.__wrapped__ = scope[pyname]  # its signature, for inspect
                scope[pyname] = func

    return _LIBRARY


